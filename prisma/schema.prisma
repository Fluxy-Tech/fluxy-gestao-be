// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Categoria do negócio, escolhida pelo usuário no cadastro da empresa — muda como o
// app se comporta: Cabeleireiro/PetShop usam a agenda (calendário + horário de
// atendimento editável); Padrão/Laboratório usam a listagem tradicional em tabela e só
// escolhem a data de entrega (sem horário).
enum BusinessCategory {
  STANDARD
  HAIRDRESSER
  LAB
  PETSHOP
}

// ===================== Better Auth core =====================
// Shape follows Better Auth's Prisma generator + the "admin" plugin
// (role / banned / banReason / banExpires / impersonatedBy).
// Business/profile fields are appended directly onto User: this app
// treats "account" and "company profile" as the same row (1:1), same
// as the old Supabase `profiles` table keyed by auth.users.id.

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // admin plugin
  role       String    @default("user")
  banned     Boolean   @default(false)
  banReason  String?
  banExpires DateTime?

  // Plano único — mantido apenas para referência de billing, não gate mais acesso a funcionalidades.
  plan String @default("mensal")

  // company/profile fields (was `profiles` table)
  phone            String?
  avatarUrl        String?
  theme            String  @default("light")
  businessCategory BusinessCategory @default(STANDARD)
  companyName      String?
  cnpj             String?
  cpf              String?
  cep              String?
  address          String?
  addressNumber    String?
  complement       String?
  neighborhood     String?
  city             String?
  state            String?
  logoUrl          String?
  primaryColor     String  @default("#8c52ff")
  pdfColor         String  @default("#8c52ff")
  includeLogoInPdf Boolean @default(true)
  orderSequence    BigInt  @default(0)

  // Saldo de caixa informado pelo usuário; ajustado pelo job de conciliação (soma o
  // faturamento das OS finalizadas e subtrai a saída de caixa desde a última
  // reconciliação — ver reconcileUserCash). cashReconciledAt é o timestamp exato da
  // última reconciliação (não um dia), para o botão manual poder rodar a qualquer
  // hora — inclusive mais de uma vez no mesmo dia — sem contar nada em duplicidade.
  currentCash      Decimal   @default(0) @db.Decimal(14, 2)
  cashReconciledAt DateTime?

  // Cobrança da assinatura Fluxy (billing da plataforma, não confundir com Debt/Expense
  // do próprio tenant). asaasCustomerId é preenchido na primeira fatura gerada e reusado
  // depois. billingBlocked é setado pelo job diário quando a fatura do mês anterior vence
  // sem pagamento — distinto de `banned` (que é o ban administrativo do plugin admin do
  // Better Auth) para não misturar as duas causas de bloqueio.
  asaasCustomerId String?
  billingBlocked  Boolean @default(false)

  // Aceite do contrato de contratação paga da plataforma — pedido ao usuário quando o mês
  // gratuito termina (ver domain/billing.ts#trialEnded). Enquanto false (nunca respondeu ou
  // recusou), o job de billing não gera fatura para este usuário e requireActiveBilling
  // bloqueia o acesso operacional até o aceite. contractAcceptedAt é só para auditoria (quando
  // aceitou pela última vez); a flag booleana é a que efetivamente controla o acesso.
  contractAccepted   Boolean   @default(false)
  contractAcceptedAt DateTime?

  // Setado pelo admin (painel admin) para usuários que não devem ser cobrados — ex.:
  // funcionários do próprio dono da conta. Isenta tanto da exigência de aceite de contrato
  // quanto da geração de fatura/boleto (ver findBillableBeforeMonth).
  billingExempt Boolean @default(false)

  sessions Session[]
  accounts Account[]

  clients    Client[]
  services   Service[]
  orders     Order[]
  orderItems OrderItem[]
  auditLogs     AuditLog[]
  expenses      Expense[]
  debts         Debt[]
  invoices      Invoice[]
  cashMovements CashMovement[]
  serviceInvoices ServiceInvoice[]

  @@map("user")
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ===================== Business tables =====================
// Single-tenant-per-user model: every row is scoped by userId,
// mirroring the RLS policies from the old Supabase schema
// (clients_all / services_all / orders_all / oi_all "user_id = auth.uid()").

model Client {
  id            String    @id @default(cuid())
  userId        String
  name          String
  email         String?
  phone         String?
  cep           String?
  address       String?
  addressNumber String?
  complement    String?
  neighborhood  String?
  city          String?
  state         String?
  cpf           String?
  cnpj          String?
  laborRate     Decimal   @default(0) @db.Decimal(6, 2)
  discount      Decimal   @default(0) @db.Decimal(6, 2)
  increase      Decimal   @default(0) @db.Decimal(6, 2)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // Sequência própria de numeração de nota fiscal de serviço, independente de outros
  // clientes — cada cliente começa do 1 (ver ServiceInvoice e o padrão já usado em
  // User.orderSequence para as OS).
  noteSequence BigInt @default(0)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders          Order[]
  serviceInvoices ServiceInvoice[]

  @@index([userId])
  @@map("client")
}

model Service {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?
  category    String?
  costPrice   Decimal   @default(0) @db.Decimal(14, 2)
  salePrice   Decimal   @default(0) @db.Decimal(14, 2)
  active      Boolean   @default(true)
  showInCatalog Boolean @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([userId])
  @@map("service")
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
}

model Order {
  id             String        @id @default(cuid())
  userId         String
  clientId       String
  numberOrder    BigInt
  // Só usado quando o usuário está na categoria LAB (ver BusinessCategory) — nome do
  // paciente ao qual o exame/serviço se refere, distinto do cliente (que é quem paga/
  // solicita). Opcional e não exibido/coletado nas demais categorias.
  patientName    String?
  statusOrder    OrderStatus   @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  paymentMethod  String?
  paymentDueDate DateTime?
  amountPaid     Decimal       @default(0) @db.Decimal(14, 2)
  // Quando o pagamento (total ou parcial) foi de fato lançado — distinto de completedAt
  // (quando a OS foi marcada como concluída). Uma OS pode ser concluída num dia e só
  // receber o pagamento (ou um pagamento parcial adicional) dias depois; faturamento e
  // conciliação de caixa usam esta data, não completedAt, para saber em que período o
  // dinheiro efetivamente entrou (ver update-payment-status.usecase.ts).
  lastPaymentAt  DateTime?
  // Quanto do valor em caixa desta OS (ver cashRevenue em domain/order-cash.ts) já foi
  // somado ao currentCash do usuário pela conciliação de caixa. Substitui uma janela de
  // tempo (que "perderia" para sempre um pagamento lançado com atraso, ver
  // daily-cash-reconciliation.job.ts): a cada rodada só soma-se a diferença entre o valor
  // atual e o que já foi contado, então o botão "Atualizar Caixa atual" pode ser clicado
  // quantas vezes quiser, sem qualquer limite de uma vez por dia.
  cashCountedAmount Decimal    @default(0) @db.Decimal(14, 2)
  entryDate      DateTime      @default(now())
  deliveryDate   DateTime?
  completedAt    DateTime?
  canceledAt     DateTime?
  cancelReason   String?
  notes          String?
  totalCost      Decimal       @default(0) @db.Decimal(14, 2)
  totalSale      Decimal       @default(0) @db.Decimal(14, 2)
  createdBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  // "OS fixa": só a OS original (o "template") carrega recurWeekly/recurMonthly — as
  // ocorrências geradas automaticamente pelo job (ver recurring-orders.job.ts) nascem com
  // as duas flags falsas e só guardam recurringParentId, pra não disparar uma nova série
  // recursiva. nextOccurrenceAt é o watermark de quando gerar a próxima ocorrência (ver
  // domain/order-recurrence.ts); fica null quando a série não é (ou não é mais) recorrente.
  recurWeekly       Boolean   @default(false)
  recurMonthly      Boolean   @default(false)
  nextOccurrenceAt  DateTime?
  recurringParentId String?

  // Trava a OS numa nota fiscal de serviço enquanto ela estiver ISSUED/SETTLED — fica
  // null de novo se a nota for cancelada (ver ServiceInvoice), liberando a OS para entrar
  // em outra nota.
  serviceInvoiceId String?

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client           Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  orderItems       OrderItem[]
  recurringParent  Order?      @relation("OrderRecurrence", fields: [recurringParentId], references: [id], onDelete: SetNull)
  recurringChildren Order[]    @relation("OrderRecurrence")
  serviceInvoice   ServiceInvoice? @relation(fields: [serviceInvoiceId], references: [id], onDelete: SetNull)

  @@unique([userId, numberOrder])
  @@index([userId])
  @@index([clientId])
  @@index([entryDate])
  @@index([statusOrder])
  @@index([nextOccurrenceAt])
  @@index([recurringParentId])
  @@index([serviceInvoiceId])
  @@map("order")
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  serviceId  String
  userId     String
  costPrice  Decimal  @db.Decimal(14, 2)
  salePrice  Decimal  @db.Decimal(14, 2)
  discount   Decimal  @default(0) @db.Decimal(6, 2)
  increase   Decimal  @default(0) @db.Decimal(6, 2)
  quantity   Decimal  @default(1) @db.Decimal(14, 3)
  finalPrice Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_item")
}

// Nota fiscal de serviço: agrupa OS já existentes de um cliente sob um número
// sequencial próprio do cliente (começa em 1, independente de outros clientes — ver
// Client.noteSequence). ISSUED = emitida; SETTLED = "dar baixa" (as OS vinculadas viram
// PAID); CANCELED = cancelada, nunca deletada — as OS que ela travou voltam a ficar livres
// (Order.serviceInvoiceId volta a null).
enum ServiceInvoiceStatus {
  ISSUED
  SETTLED
  CANCELED
}

model ServiceInvoice {
  id           String               @id @default(cuid())
  userId       String
  clientId     String
  number       BigInt
  issueDate    DateTime             @default(now())
  // Soma do totalSale das OS vinculadas no momento da criação — não recalculado depois,
  // é o valor "impresso" na nota.
  totalAmount  Decimal              @default(0) @db.Decimal(14, 2)
  status       ServiceInvoiceStatus @default(ISSUED)
  settledAt    DateTime?
  canceledAt   DateTime?
  cancelReason String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  orders Order[]

  @@unique([clientId, number])
  @@index([userId])
  @@index([clientId])
  @@index([status])
  @@index([issueDate])
  @@map("service_invoice")
}

// ===================== Financeiro =====================
// Company expenses. Recurring expenses are stored as a single template row
// (isRecurring=true, recurrenceFrequency set) and expanded into virtual
// occurrences on the fly by the financial-report/list usecases for whatever
// date range is requested — no background job pre-generates rows.

enum RecurrenceFrequency {
  MONTHLY
}

enum ExpenseStatus {
  PENDING
  PAID
}

model Expense {
  id                  String               @id @default(cuid())
  userId              String
  description         String
  amount              Decimal              @db.Decimal(14, 2)
  category            String?
  date                DateTime
  status              ExpenseStatus        @default(PENDING)
  isRecurring         Boolean              @default(false)
  recurrenceFrequency RecurrenceFrequency?
  recurrenceEndDate   DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?

  // Watermark próprio desta despesa para a conciliação de caixa (ver reconcileUserCash):
  // instante até o qual as ocorrências já pagas desta despesa já foram somadas ao
  // currentCash. Substitui uma janela global por dia (que "perdia" para sempre uma
  // despesa lançada no mesmo dia de uma reconciliação anterior) pelo mesmo padrão já
  // usado em Order.cashCountedAmount — idempotente e sem depender de fronteira de dia.
  cashCountedUntil DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@map("expense")
}

// Dívidas da empresa. Pagamento funciona como nas OS: pode ser
// quitado integralmente ou parcialmente (amountPaid + paymentStatus, mesmo enum
// PaymentStatus usado em Order).
model Debt {
  id            String        @id @default(cuid())
  userId        String
  description   String
  amount        Decimal       @db.Decimal(14, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(14, 2)
  paymentStatus PaymentStatus @default(PENDING)
  category      String?
  date          DateTime
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@map("debt")
}

// Registro de cada entrada/saída aplicada ao currentCash pela conciliação de caixa
// (job diário ou botão "Atualizar Caixa atual") — ver daily-cash-reconciliation.job.ts.
// Cada OS/despesa que contribui para uma rodada de conciliação gera sua própria linha,
// para dar rastreabilidade total de "de onde veio" cada ajuste de caixa.
enum CashMovementType {
  IN
  OUT
}

model CashMovement {
  id          String           @id @default(cuid())
  userId      String
  type        CashMovementType
  amount      Decimal          @db.Decimal(14, 2)
  description String
  occurredAt  DateTime
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([occurredAt])
  @@map("cash_movement")
}

// ===================== Cobrança da plataforma (Asaas) =====================
// Uma fatura por usuário por mês de competência (referenceMonth "YYYY-MM"). O
// primeiro mês do usuário na plataforma é gratuito (nenhuma Invoice é criada para
// o mês do cadastro). status só reflete PENDING/PAID — "vencido" não é um estado
// gravado, é calculado a partir de dueDate < hoje (ver list-invoices usecase),
// assim "gerar novo link" só precisa trocar asaasPaymentId/asaasInvoiceUrl/dueDate
// sem precisar migrar de estado.
enum InvoiceStatus {
  PENDING
  PAID
  CANCELED
}

model Invoice {
  id               String        @id @default(cuid())
  userId           String
  referenceMonth   String
  amount           Decimal       @db.Decimal(14, 2)
  status           InvoiceStatus @default(PENDING)
  dueDate          DateTime
  paidAt           DateTime?
  asaasPaymentId   String?       @unique
  asaasInvoiceUrl  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, referenceMonth])
  @@index([userId])
  @@index([status])
  @@map("invoice")
}

// ===================== Admin panel / auditoria =====================

enum LogType {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  STATUS_CHANGE
  PAYMENT
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  about      String
  type       LogType
  entityId   String?
  entityType String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([type])
  @@map("audit_log")
}
